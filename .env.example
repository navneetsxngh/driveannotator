# Copy to .env and fill in. Never commit or share .env.

# Hugging Face read token (https://huggingface.co/settings/tokens).
# Account must have accepted the nvidia/PhysicalAI-Autonomous-Vehicles license.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Output locations (optional; defaults are ./data/...). Use a drive with ~10+ GB free.
DATA_ROOT=./data/dataset_v1
LOCAL_WORK=./data/_work
HF_CACHE_DIR=./data/_hf_cache

# Windows: silence HF cache symlink warning
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Faster, more robust HF downloads
HF_HUB_DOWNLOAD_TIMEOUT=60
